--macro lime._internal.macros.DefineMacro.run()
-cp C:/haxelib/lime/8,1,2/src
-D lime=8.1.2
--macro keep('IntIterator')
-cp C:/haxelib/hscript/2,6,0
-D hscript=2.6.0
-cp C:/haxelib/haxeui-flixel/1,7,0
-D haxeui-flixel=1.7.0
