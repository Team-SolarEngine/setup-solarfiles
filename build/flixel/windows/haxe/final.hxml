-D flixel=5.5.0
-D haxeui
-cp C:/haxelib/haxeui-core/1,7,0
-D haxeui-core=1.7.0
-cp src
-D lime-openal
-D FLX_NO_GAMEPAD
-D FLX_NO_SOUND_SYSTEM
-D native
-D lime-curl
-D openfl-native
-D lime-harfbuzz
